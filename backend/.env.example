# ==============================================================================
# VIGIL Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# --- Elastic Cloud Configuration (Free Trial or Production) ---
# Find your Cloud ID in the Elastic Cloud Console deployment overview
ELASTIC_CLOUD_ID=

# Create an API Key in Kibana -> Stack Management -> API Keys
ELASTIC_API_KEY=

# Alternatively, specify direct Elasticsearch URL (e.g., https://localhost:9200 or Cloud endpoint)
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Enable live Elasticsearch cluster connection (falls back to mock engine if false or if keys are missing)
USE_LIVE_ELASTIC=true

# --- AWS Bedrock Configuration (Optional / Falls back to deterministic engine) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
USE_LIVE_BEDROCK=false

# --- Sarvam AI Configuration (Optional / Falls back to local Indic translation matrix) ---
SARVAM_API_KEY=
USE_LIVE_SARVAM=false

# --- Server & Security Settings ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=vigil-hackathon-secret-key-2026-ap-south-1
KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/vigil-ledger-sign-key
